# Append selected settings to your deployment environment. No credentials here.
STORAGE_KEEP_ALIVE=false
STORAGE_MAX_SOCKETS=32
STORAGE_DEADLINE_MS=15000
PROTECTED_PLAYBACK=false
PLAYBACK_SESSIONS_ENABLED=false
PLAYBACK_TEST_USER_IDS=
# PLAYBACK_SECRET=<at-least-32-random-characters>
PLAYBACK_TTL_SECONDS=7200
# PUBLIC_MEDIA_BASE_URL=https://your-public-image-cdn.example
IMAGE_CDN_REDIRECT_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_IP_PER_MINUTE=3000
RATE_LIMIT_MEDIA_PER_MINUTE=6000
# Set only the actual proxy subnets; do not trust all forwarded addresses.
TRUSTED_PROXY_CIDRS=
# To opt in: COMPOSE_PROFILES=cache, plus the generated cache credentials/URL.
# CACHE_REDIS_PASSWORD and CACHE_REDIS_URL come from scripts/generate-rollout-secrets.cjs.
# METRICS_TOKEN=<at-least-32-random-characters>
FFMPEG_THREADS=2
FFMPEG_TIMEOUT_MS=3600000
MONITOR_SUSTAINED_SAMPLES=3
